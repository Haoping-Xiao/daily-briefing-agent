CURSOR_API_KEY=xx

# Tracing backend: langfuse | traceroot | laminar | lmnr | braintrust | bt | noop (also: none, off, false, disabled)
TRACING_PROVIDER=langfuse

# Langfuse (default cloud: no base URL needed)
LANGFUSE_PUBLIC_KEY="pk-lf-.."
LANGFUSE_SECRET_KEY="sk-lf-.."
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# TraceRoot (default: https://app.traceroot.ai)
TRACEROOT_API_KEY=tr-..
# TRACEROOT_HOST_URL=https://app.traceroot.ai
# Git context for source correlation (auto-detected locally / in GitHub Actions)
TRACEROOT_GIT_REPO=Haoping-Xiao/daily-briefing-agent
TRACEROOT_GIT_REF=

# Laminar (default: https://api.lmnr.ai)
LMNR_PROJECT_API_KEY=
# LMNR_BASE_URL=https://api.lmnr.ai

# Braintrust (default: https://api.braintrust.dev)
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT_ID=
# BRAINTRUST_API_URL=https://api.braintrust.dev
# BRAINTRUST_PARENT=project_id:...  # optional override; BRAINTRUST_PROJECT_ID is enough for most cases
